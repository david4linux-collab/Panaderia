<div class="mb-6">
  <%= link_to "← Volver", categories_path, class: "text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= @category.name %></h1>
  <% if @category.description.present? %>
    <p class="text-gray-600 mb-6"><%= @category.description %></p>
  <% end %>

  <div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold">Productos</h2>
    <%= link_to "Nuevo Producto", new_product_path(category_id: @category.id), class: "btn-primary text-sm" %>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @products.each do |product| %>
        <div class="border border-gray-200 rounded-lg p-4">
          <h3 class="font-medium text-gray-800"><%= product.name %></h3>
          <p class="text-lg font-bold text-green-600 mt-1"><%= number_to_currency(product.price) %></p>
          <p class="text-sm text-gray-500 mt-2"><%= truncate(product.description, length: 80) if product.description %></p>
          <div class="mt-3">
            <%= link_to "Ver", product, class: "text-blue-600 hover:text-blue-800 text-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No hay productos en esta categoría.</p>
  <% end %>
</div>
