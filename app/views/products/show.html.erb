<div class="mb-6">
  <%= link_to "← Volver", products_path, class: "text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-800"><%= @product.name %></h1>
      <p class="text-gray-500 mt-1"><%= @product.category.name %></p>
    </div>
    <span class="px-3 py-1 text-sm font-semibold rounded-full <%= @product.available ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
      <%= @product.available ? "Disponible" : "No disponible" %>
    </span>
  </div>

  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Detalles</h2>
      <p class="text-3xl font-bold text-green-600 mb-4"><%= number_to_currency(@product.price) %></p>
      <% if @product.description.present? %>
        <p class="text-gray-600"><%= @product.description %></p>
      <% end %>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Receta (Ingredientes)</h2>
      <% if @product.product_ingredients.joins(:ingredient).where.not(quantity: 0).any? %>
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left text-sm font-medium text-gray-500">Ingrediente</th>
              <th class="text-right text-sm font-medium text-gray-500">Cantidad</th>
              <th class="text-right text-sm font-medium text-gray-500">Costo</th>
            </tr>
          </thead>
          <tbody>
            <% @product.product_ingredients.joins(:ingredient).where.not(quantity: 0).each do |pi| %>
              <tr>
                <td class="py-2 text-gray-800"><%= pi.ingredient.name %></td>
                <td class="py-2 text-right text-gray-600"><%= pi.quantity %> <%= pi.ingredient.unit %></td>
                <td class="py-2 text-right text-gray-600"><%= number_to_currency(pi.ingredient.cost * pi.quantity) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <p class="text-sm text-gray-500">Costo total: <span class="font-medium text-gray-800"><%= number_to_currency(@product.total_cost) %></span></p>
          <p class="text-sm text-gray-500">Margen de ganancia: <span class="font-medium text-green-600"><%= @product.profit_margin %>%</span></p>
        </div>
      <% else %>
        <p class="text-gray-500">No hay ingredientes definidos para este producto.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="flex justify-end space-x-3">
  <%= link_to "Editar", edit_product_path(@product), class: "btn-secondary" %>
  <%= link_to "Eliminar", @product, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "btn-danger" %>
</div>
