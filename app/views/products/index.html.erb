<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-gray-800">Productos</h1>
  <%= link_to "Nuevo Producto", new_product_path, class: "btn-primary" %>
</div>

<div class="mb-4 flex gap-4">
  <%= link_to "Todos", products_path, class: "text-sm text-gray-600 hover:text-gray-800" %>
  <%= link_to "Disponibles", products_path(available: true), class: "text-sm text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Disponible</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @products.each do |product| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="font-medium text-gray-800"><%= product.name %></div>
            <% if product.description.present? %>
              <div class="text-sm text-gray-500"><%= truncate(product.description, length: 60) %></div>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= product.category.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right font-medium"><%= number_to_currency(product.price) %></td>
          <td class="px-6 py-4 whitespace-nowrap text-center">
            <span class="px-2 py-1 text-xs font-semibold rounded-full <%= product.available ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
              <%= product.available ? "Sí" : "No" %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
            <%= link_to "Ver", product, class: "text-blue-600 hover:text-blue-800" %>
            <%= link_to "Editar", edit_product_path(product), class: "text-gray-600 hover:text-gray-800" %>
            <%= link_to "Eliminar", product, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "text-red-600 hover:text-red-800" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
