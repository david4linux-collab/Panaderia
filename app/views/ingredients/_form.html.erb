<%= form_with(model: ingredient, local: true) do |f| %>
  <% if ingredient.errors.any? %>
    <div class="mb-4 p-4 bg-red-100 border border-red-200 text-red-800 rounded-lg">
      <ul class="list-disc list-inside">
        <% ingredient.errors.each do |attribute, message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :unit, %w[kg g litro ml unidad], { include_blank: "Selecciona una unidad" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= f.label :cost, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :cost, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= f.label :stock, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :stock, step: 0.001, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3 mt-6">
    <%= link_to "Cancelar", ingredients_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
