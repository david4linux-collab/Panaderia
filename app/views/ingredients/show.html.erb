<div class="mb-6">
  <%= link_to "← Volver", ingredients_path, class: "text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-3xl font-bold text-gray-800"><%= @ingredient.name %></h1>

  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Detalles</h2>
      <p class="text-gray-600 mb-2"><strong>Unidad:</strong> <%= @ingredient.unit %></p>
      <p class="text-gray-600 mb-2"><strong>Costo:</strong> <%= number_to_currency(@ingredient.cost) %></p>
      <p class="text-gray-600 mb-2"><strong>Stock:</strong>
        <span class="<%= 'text-red-600 font-bold' if @ingredient.low_stock? %>"><%= @ingredient.stock %></span>
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Productos que lo usan</h2>
      <% if @ingredient.products.any? %>
        <ul class="list-disc list-inside">
          <% @ingredient.products.each do |product| %>
            <li class="text-gray-600"><%= link_to product.name, product, class: "text-blue-600 hover:text-blue-800" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">No se usa en ningún producto.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-4 flex justify-end space-x-3">
  <%= link_to "Editar", edit_ingredient_path(@ingredient), class: "btn-secondary" %>
  <%= link_to "Eliminar", @ingredient, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "btn-danger" %>
</div>
