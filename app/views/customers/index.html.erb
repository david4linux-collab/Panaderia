<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-gray-800">Clientes</h1>
  <%= link_to "Nuevo Cliente", new_customer_path, class: "btn-primary" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Teléfono</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @customers.each do |customer| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800"><%= customer.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= customer.email %></td>
          <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= customer.phone %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
            <%= link_to "Ver", customer, class: "text-blue-600 hover:text-blue-800" %>
            <%= link_to "Editar", edit_customer_path(customer), class: "text-gray-600 hover:text-gray-800" %>
            <%= link_to "Eliminar", customer, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "text-red-600 hover:text-red-800" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
