<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-2">Dashboard</h1>
  <p class="text-gray-600">Resumen de la panadería</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-medium text-gray-500 mb-2">Productos</h3>
    <p class="text-3xl font-bold text-gray-800"><%= @total_products %></p>
    <p class="text-sm text-gray-500 mt-1"><%= @available_products %> disponibles</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-medium text-gray-500 mb-2">Ingredientes</h3>
    <p class="text-3xl font-bold text-gray-800"><%= @total_ingredients %></p>
    <p class="text-sm text-red-500 mt-1"><%= @low_stock_ingredients %> con bajo stock</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-medium text-gray-500 mb-2">Pedidos</h3>
    <p class="text-3xl font-bold text-gray-800"><%= @total_orders %></p>
    <p class="text-sm text-gray-500 mt-1"><%= @today_orders %> hoy | <%= @pending_orders %> pendientes</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-sm font-medium text-gray-500 mb-2">Clientes</h3>
    <p class="text-3xl font-bold text-gray-800"><%= @total_customers %></p>
    <p class="text-sm text-gray-500 mt-1">Ingresos hoy: <%= number_to_currency(@today_revenue) %></p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Pedidos Recientes</h2>
    <% if @recent_orders.any? %>
      <div class="space-y-3">
        <% @recent_orders.each do |order| %>
          <div class="flex justify-between items-center p-3 border border-gray-200 rounded-lg">
            <div>
              <p class="font-medium">#<%= order.id %> - <%= order.customer.name %></p>
              <p class="text-sm text-gray-500"><%= l(order.created_at, format: :short) %></p>
            </div>
            <div class="text-right">
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-<%= order.status == 'completed' ? 'green' : order.status == 'cancelled' ? 'red' : 'yellow' %>-100 text-<%= order.status == 'completed' ? 'green' : order.status == 'cancelled' ? 'red' : 'yellow' %>-800">
                <%= order.status %>
              </span>
              <p class="text-sm font-medium mt-1"><%= number_to_currency(order.total) %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No hay pedidos recientes.</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Ingredientes con Bajo Stock</h2>
    <% if @low_stock_list.any? %>
      <div class="space-y-3">
        <% @low_stock_list.each do |ingredient| %>
          <div class="flex justify-between items-center p-3 border border-gray-200 rounded-lg">
            <div>
              <p class="font-medium"><%= ingredient.name %></p>
              <p class="text-sm text-gray-500"><%= ingredient.unit %></p>
            </div>
            <span class="text-red-600 font-bold"><%= ingredient.stock %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">Todos los ingredientes tienen suficiente stock.</p>
    <% end %>
  </div>
</div>
