<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold text-gray-800">Pedidos</h1>
  <%= link_to "Nuevo Pedido", new_order_path, class: "btn-primary" %>
</div>

<div class="mb-4 flex gap-4">
  <%= link_to "Todos", orders_path, class: "text-sm text-gray-600 hover:text-gray-800" %>
  <%= link_to "Pendientes", orders_path(status: "pending"), class: "text-sm text-yellow-600 hover:text-yellow-800" %>
  <%= link_to "Hoy", orders_path(today: "true"), class: "text-sm text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @orders.each do |order| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800"><%= order.id %></td>
          <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= order.customer.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-center">
            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-<%= order.status == 'completed' ? 'green' : order.status == 'cancelled' ? 'red' : 'yellow' %>-100 text-<%= order.status == 'completed' ? 'green' : order.status == 'cancelled' ? 'red' : 'yellow' %>-800">
              <%= order.status %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-center text-gray-600"><%= order.item_count %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right font-medium"><%= number_to_currency(order.total) %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
            <%= link_to "Ver", order, class: "text-blue-600 hover:text-blue-800" %>
            <%= link_to "Editar", edit_order_path(order), class: "text-gray-600 hover:text-gray-800" %>
            <%= link_to "Eliminar", order, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "text-red-600 hover:text-red-800" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
