<div class="mb-6">
  <%= link_to "← Volver", orders_path, class: "text-gray-600 hover:text-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-6"><%= action_name == "new" ? "Nuevo Pedido" : "Editar Pedido" %></h1>

  <%= form_with(model: @order, local: true) do |f| %>
    <% if @order.errors.any? %>
      <div class="mb-4 p-4 bg-red-100 border border-red-200 text-red-800 rounded-lg">
        <ul class="list-disc list-inside">
          <% @order.errors.each do |attribute, message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :customer_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :customer_id, @customers, :id, :name, { include_blank: "Selecciona un cliente" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status, Order.statuses.keys, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
    </div>

    <div class="mt-4">
      <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notes, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div class="mt-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Productos</h2>
      <%= f.fields_for :order_items do |oif| %>
        <div class="mb-3 flex items-end gap-3">
          <div class="flex-1">
            <%= oif.label :product_id, "Producto", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= oif.collection_select :product_id, @products, :id, :name, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
          <div class="w-32">
            <%= oif.label :quantity, "Cantidad", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= oif.number_field :quantity, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
          <%= oif.hidden_field :price %>
        </div>
      <% end %>
    </div>

    <div class="flex justify-end space-x-3 mt-6">
      <%= link_to "Cancelar", orders_path, class: "btn-secondary" %>
      <%= f.submit class: "btn-primary" %>
    </div>
  <% end %>
</div>
